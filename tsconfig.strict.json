{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "contexts/AIContext/models.ts",
    "hooks/buildStatusTypes.ts",
    "lib/appInfoBackup.ts",
    "lib/appInfoScopedBackup.ts",
    "lib/validation/**/*.ts",
    "lib/validation/**/*.d.ts"
  ]
}
