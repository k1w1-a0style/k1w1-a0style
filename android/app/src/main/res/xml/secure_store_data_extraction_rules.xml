<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Fail-closed: exclude all app data from cloud backup payloads. -->
    <exclude domain="root" path="." />
    <!-- Explicitly document SecureStore exclusion for contract clarity. -->
    <exclude domain="sharedpref" path="SecureStore" />
  </cloud-backup>
  <device-transfer>
    <!-- Fail-closed: exclude all app data from device-to-device transfer payloads. -->
    <exclude domain="root" path="." />
    <!-- Explicitly document SecureStore exclusion for contract clarity. -->
    <exclude domain="sharedpref" path="SecureStore" />
  </device-transfer>
</data-extraction-rules>
