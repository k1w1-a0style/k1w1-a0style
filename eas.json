{
  "cli": {
    "version": "16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "production": {
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "NODE_ENV": "production",
        "PRECHECK": "true"
      }
    }
  }
}
