# Copy to .env.ci-lite.local and fill values (DO NOT COMMIT .env.ci-lite.local)
SUPABASE_URL=https://<your-project-ref>.supabase.co
K1W1_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Workflow/Admin auth for trigger/check/logs/runs/dispatch/artifact routes
ADMIN_KEY=
K1W1_EDGE_WORKFLOW_ADMIN_KEY=
K1W1_EDGE_WORKFLOW_CI_BEARER=

# Admin-only auth for android-keystore-export
K1W1_EDGE_ANDROID_KEYSTORE_EXPORT_ADMIN_KEY=

# Used by signing functions
SIGNING_MASTER_KEY=

# Optional
GITHUB_TOKEN=
EXPO_TOKEN=
