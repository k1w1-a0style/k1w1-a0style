# Copy to .env.ci-lite.local and fill values (DO NOT COMMIT .env.ci-lite.local)
SUPABASE_URL=https://<your-project-ref>.supabase.co
K1W1_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Must match the Supabase secret SIGNING_ADMIN_KEY / K1W1_EDGE_ADMIN_KEY
ADMIN_KEY=
K1W1_EDGE_ADMIN_KEY=
SIGNING_ADMIN_KEY=

# Used by signing functions
SIGNING_MASTER_KEY=

# Optional
GITHUB_TOKEN=
EXPO_TOKEN=
